# Public Firebase Web configuration. These values identify the Firebase project;
# they are not service-account credentials.
VITE_FIREBASE_API_KEY=${FIREBASE_WEB_API_KEY}
VITE_FIREBASE_AUTH_DOMAIN=${FIREBASE_STAGING_PROJECT_ID}.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=${FIREBASE_STAGING_PROJECT_ID}
VITE_FIREBASE_STORAGE_BUCKET=${FIREBASE_STAGING_PROJECT_ID}.appspot.com
VITE_FIREBASE_APP_ID=${FIREBASE_WEB_APP_ID}
VITE_COLLABORATION_URL=wss://${COLLABORATION_HOST}

# Server environment rendered by the staging release pipeline.
GCP_PROJECT_ID=${FIREBASE_STAGING_PROJECT_ID}
GCP_LOCATION=asia-northeast3
FIREBASE_STORAGE_BUCKET=${FIREBASE_STAGING_PROJECT_ID}.appspot.com
PARSE_QUEUE=rhwp-parse-staging
PARSE_WORKER_URL=https://${PARSE_WORKER_HOST}/run
EXPORT_QUEUE=rhwp-export-staging
EXPORT_WORKER_URL=https://${EXPORT_WORKER_HOST}/run
TASKS_SERVICE_ACCOUNT_EMAIL=rhwp-tasks-staging@${FIREBASE_STAGING_PROJECT_ID}.iam.gserviceaccount.com
COLLABORATION_FLUSH_URL=https://${COLLABORATION_HOST}

# INTERNAL_API_TOKEN and COLLABORATION_INTERNAL_TOKEN are supplied only through
# Secret Manager references in Cloud Run. Never put their values in this file.
